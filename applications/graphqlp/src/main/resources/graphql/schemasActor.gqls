type Mutation {

	putActor(first_name: String, last_name: String, last_update: String): Actor
}

input CreateInputActor {

	first_name: String
	last_name: String
	last_update: String
}

type Actor {

	"actor_id, first_name, last_name, last_update"
	actor_id: ID
	first_name: String
	last_name: String
	last_update: String
}

