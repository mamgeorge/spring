type Actor {

	# actor_id, first_name, last_name, last_update
	actor_id: ID!
	first_name: String
	last_name: String
#	last_update: TimeStamp
}

type Address {

	# address_id, address, address2, district, city_id, postal_code, phone, last_update
	address_id: ID!
	address: String
	address2: String
	district: String
	city_id: Int
	postal_code: String
	phone: String
#	last_update: TimeStamp
}

type City {

	# city_id, city, country_id, last_update
	city_id: ID!
	city: String
	country_id: Int
#	last_update: TimeStamp
}

type Query {

	getAddresses(count: Int): [Address]!
}

# type Query { getAddress(address_id: ID): [Address]! }

