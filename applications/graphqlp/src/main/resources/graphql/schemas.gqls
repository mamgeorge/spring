type Query {

	getAddresses(count: Int): [Address]!
	getCities(count: Int): [City]!
	getActors(count: Int): [Actor]!

	addressById(address_id: ID): Address
	cityById(city_id: ID): City
	actorById(actor_id: ID): Actor

	getAddressRng(beg: Int, end: Int): [Address]!
}

type Address {

	# address_id, address, address2, district, city_id, postal_code, phone, last_update
	address_id: ID
	address: String
	address2: String
	district: String
	city_id: Int
	city: City
	postal_code: String
	phone: String
	last_update: String
}

type City {

	# city_id, city, country_id, last_update
	city_id: ID
	city_name: String
	country_id: Int
	last_update: String
}

type Actor {

	"actor_id, first_name, last_name, last_update"
	actor_id: ID
	first_name: String
	last_name: String
	last_update: String
}

"datafetchers or resolver functions"
type Mutation {

	putActor(first_name: String, last_name: String, last_update: String): Actor
}

input CreateInputActor {

	first_name: String
	last_name: String
	last_update: String
}

