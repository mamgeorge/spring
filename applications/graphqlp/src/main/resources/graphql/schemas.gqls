type Address {

	# address_id, address, address2, district, city_id, postal_code, phone, last_update
	address_id: ID
	address: String
	address2: String
	district: String
	city_id: Int
	city: City
	postal_code: String
	phone: String
	last_update: String
}

type City {

	# city_id, city, country_id, last_update
	city_id: ID
	city_name: String
	country_id: Int
	last_update: String
}

