type Query {

	getCustomersRng(beg: Int, end: Int): [Customer]
	getAddressesRng(beg: Int, end: Int): [Address]
	getCitiesRng(beg: Int, end: Int): [City]
	getActorsRng(beg: Int, end: Int): [Actor]

	customerById(customer_id: ID): Customer
	addressById(address_id: ID): Address
	cityById(city_id: ID): City
	actorById(actor_id: ID): Actor
}

type Mutation {

	addActorInf(first_name: String!, last_name: String!): Actor

	addActorObj(actor: ActorInput!): Actor

	modActor(id: ID!, actor: ActorInput!): Actor

	delActor(id: ID!): Actor
}

type Customer {

	# customer_id, store_id, active, activebool, address_id, email, first_name, last_name, create_date, last_update
	customer_id	: ID
	store_id	: Int
	active		: Int
	activebool	: Boolean
	address_id	: Int
	address		: Address
	email		: String
	first_name	: String
	last_name	: String
	create_date	: String
	last_update	: String
}

type Address {

	# address_id, address, address2, district, city_id, postal_code, phone, last_update
	address_id	: ID
	address		: String
	address2	: String
	district	: String
	city_id		: Int
	city		: City
	postal_code	: String
	phone		: String
	last_update	: String
}

type City {

	# city_id, city, country_id, last_update
	city_id		: ID
	city		: String
	country_id	: Int
	last_update	: String
}

type Actor {

	"actor_id, first_name, last_name, last_update"
	actor_id	: ID
	first_name	: String
	last_name	: String
	last_update	: String
}

input ActorInput {

	first_name	: String
	last_name	: String
}
