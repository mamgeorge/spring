query addr { addressById(id: 3) {

	address_id
	address
	district
	city_id
	phone
	last_update
} }

query addrCty { addressById(id: 3) {

	address_id
	address
	district
	city_id
	city {
		id
		city_name
		country_id
		last_update
	}
	phone
	last_update
} }

query addrCtyVar($id: ID!) { # variable: { "id": 3 }
	addressById(address_id: $id) {

	address_id
	address
	district
	city_id
	city {
		id
		city_name
		country_id
		last_update
	}
	phone
	last_update
} }

query addrRng { getAddressRng(beg: 2, end: 4) {

	address_id
	address
	district
	city_id
	city {
		city_id
		city_name
		country_id
		last_update
	}
	phone
	last_update
} }

query addrRng($beg: Int, $end: Int)  { #{ "beg": 10, "end": 12 }
	getAddressRng(beg: $beg, end: $end) {

	address_id
	address
	district
	city_id
	city {
		city_id
		city_name
		country_id
		last_update
	}
	phone
	last_update
} }

query cty { getCity(city_id: 300) {

	city_id
	city_name
	country_id
	last_update
} }

query addrFullCtr { getAddresses(count: 4) {

	address_id
	address
	district
	city_id
	phone
	last_update
} }

query addrCtyCtr { getAddresses(count: 4) {

	address_id
	address
	district
	city_id
	city {
		city_id
		city_name
		country_id
		last_update
	}
	phone
	last_update
} }

mutation saveActor {

	putActor( input:
	{ first_name: "Martin", last_name: "George", last_update: "2024-04-22 10:00:10.1"} ) {

		actor {
			address_id
			first_name
			last_name
			last_update
		}
	}
}

mutation saveActor1
	($first_name: String, $last_name: String, $last_update: String ) {

	putActor
	( first_name: $first_name, last_name: $last_name, last_update: $last_update) {

		actor {
			address_id
			first_name
			last_name
			last_update
		}
	}
}

mutation saveActor2 ($input: InputActor! ) {

	putActor( input: $input) {

		actor {
			address_id
			first_name
			last_name
			last_update
		}
	}
}

