query addrOne {

	getAddressRng(beg: 10, end: 12) {

		address_id
		address
		district
		last_update
	} }

query addrUno {

	getAddressRng(beg: 10, end: 12) {

		address_id
		address
		district
		city_id
		city {
			city_name
			country_id
		}
		phone
		last_update
	} }

# { "beg": 10, "end": 12 }
query addrRng($beg: Int, $end: Int)  {

	getAddressRng(beg: $beg, end: $end) {

		address_id
		address
		district
		city_id
		city {
			city_id
			city_name
			country_id
			last_update
		}
		phone
		last_update
	} }

# { "$addr": 10 }
query addrId($addr: ID) {

	addressById(address_id: $addr ) {

	address
	district
	city_id
} }

# {"ctyid": 295 }
query ctyId($ctyid: ID) {

	cityById(city_id: $ctyid ) {

	city_id
	city_name
	country_id
	last_update
} }

# { "cnt": 10 }
query ctyCnt($cnt: Int) {

	getCities(count: $cnt) {
		city_id
		city_name
		country_id
		last_update
	}
}
