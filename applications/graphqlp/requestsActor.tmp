
mutation saveActor {

	putActor( first_name: "Martin", last_name: "George", last_update: "2024-04-22 10:00:10.1" )
	{
		actor {
			address_id
			first_name
			last_name
			last_update
		}
	}
}

mutation saveActor {

	putActor( input:
	{ first_name: "Martin", last_name: "George", last_update: "2024-04-22 10:00:10.1"} ) {

		actor {
			address_id
			first_name
			last_name
			last_update
		}
	}
}

mutation saveActor1
	($first_name: String, $last_name: String, $last_update: String ) {

	putActor
	( first_name: $first_name, last_name: $last_name, last_update: $last_update) {

		actor {
			address_id
			first_name
			last_name
			last_update
		}
	}
}

mutation saveActor2 ($input: InputActor! ) {

	putActor( input: $input) {

		actor {
			address_id
			first_name
			last_name
			last_update
		}
	}
}

